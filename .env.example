# Скопируйте в .env и заполните под свой доступ к LLM.
# Для офлайн-режима (только эвристики) ничего заполнять не нужно.

# auto | anthropic | openai | offline
TZR_PROVIDER=auto

# Идентификатор модели. Примеры:
#   Anthropic:        claude-opus-5   (дешевле: claude-sonnet-5)
#   OpenAI:           gpt-4o-mini
#   OpenRouter:       openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, ...
#   Локально (Ollama):llama3.1, qwen2.5:14b-instruct, ...
TZR_MODEL=

# Ключ API. Подхватывается также из ANTHROPIC_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY.
TZR_API_KEY=

# Base URL для OpenAI-совместимых эндпоинтов:
#   OpenRouter:            https://openrouter.ai/api/v1
#   Ollama:                http://localhost:11434/v1
#   vLLM / LM Studio:      http://localhost:8000/v1
#   Внутренний контур МТС: <адрес прокси>
TZR_BASE_URL=

# Прочее (можно не трогать)
TZR_MAX_TOKENS=16000
TZR_TEMPERATURE=0.2
TZR_TIMEOUT=180
